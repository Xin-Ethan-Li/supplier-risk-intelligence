---
import { profile } from "../data/portfolio";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const pageTitle = title === profile.name ? `${profile.name} — ${profile.role}` : `${title} — ${profile.name}`;
const socialImage = new URL(image ?? `${base}og.svg`, Astro.site);
const analyticsId = import.meta.env.PUBLIC_GA_ID;
const anchor = (id: string) => `${base}#${id}`;
const isHome = path === base || path === base.slice(0, -1);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body style={`--accent-color: ${profile.accentColor}`}>
    <a class="skip-link" href="#content">Skip to content</a>
    <header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-white/90 backdrop-blur-sm transition-all duration-300 md:bg-transparent md:backdrop-blur-none">
      <nav class="mx-auto max-w-7xl overflow-x-auto px-4 py-4 sm:px-8" aria-label="Primary navigation">
        <ul class="flex min-w-max items-center justify-center gap-4 text-xs font-medium text-gray-700 sm:gap-7 sm:text-sm md:gap-8">
          <li><a href={base} class={`transition-colors hover:text-black ${isHome ? "text-black" : ""}`}>Home</a></li>
          <li><a href={anchor("about")} class="transition-colors hover:text-black">About</a></li>
          <li><a href={anchor("projects")} class="transition-colors hover:text-black">Projects</a></li>
          <li><a href={anchor("experience")} class="transition-colors hover:text-black">Experience</a></li>
          <li class="hidden sm:list-item"><a href={anchor("education")} class="transition-colors hover:text-black">Education</a></li>
          <li><a href={`${base}resume/`} class={path.startsWith(`${base}resume`) ? "text-black" : "transition-colors hover:text-black"}>Resume</a></li>
        </ul>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="relative border-t border-gray-200 bg-gray-50">
      <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 md:flex-row md:items-center md:justify-between lg:px-8">
        <div class="flex flex-col gap-3">
          <h2 class="text-2xl font-bold text-gray-800">{profile.name}</h2>
          <p class="text-base text-gray-600">{profile.role} · {profile.location}</p>
          <div class="flex gap-5 pt-1">
            <a href={`mailto:${profile.email}`} aria-label="Email" class="text-gray-600 transition-colors hover:text-[var(--accent-color)]">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/><path d="m3 7 9 6 9-6"/></svg>
            </a>
            <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-gray-600 transition-colors hover:text-[var(--accent-color)]">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
            </a>
          </div>
        </div>
        <div class="flex flex-col gap-4 md:items-end">
          <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-600" aria-label="Footer navigation">
            <a href={anchor("about")} class="hover:text-gray-900">About</a>
            <a href={anchor("projects")} class="hover:text-gray-900">Projects</a>
            <a href={`${base}resume/`} class="hover:text-gray-900">Resume</a>
            <a href={`mailto:${profile.email}`} class="hover:text-gray-900">Contact</a>
          </nav>
          <p class="text-xs text-gray-500">© {new Date().getFullYear()} {profile.name}. Built with Astro.</p>
          <p class="text-[0.68rem] text-gray-600">Design adapted from Ryan Fitzgerald's DevPortfolio (MIT).</p>
        </div>
      </div>
    </footer>
    <script>
      const header = document.getElementById("site-header");
      const updateHeader = () => {
        if (window.scrollY > 100) header?.classList.add("md:bg-white/80", "md:backdrop-blur-sm", "md:border-gray-200");
        else header?.classList.remove("md:bg-white/80", "md:backdrop-blur-sm", "md:border-gray-200");
      };
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });
    </script>
    {analyticsId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>}
    {analyticsId && <script is:inline define:vars={{ analyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', analyticsId, { anonymize_ip: true });
    </script>}
  </body>
</html>
