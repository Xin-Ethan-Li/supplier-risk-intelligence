---
interface Props {
  project: {
    number: string;
    title: string;
    category: string;
    description: string;
    tags: readonly string[];
    caseStudy: boolean;
    slug: string;
    code: string;
    demo?: string;
  };
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const destination = project.caseStudy ? `${base}projects/${project.slug}/` : project.code;
---

<article class="group relative rounded-2xl border border-gray-200 bg-gray-50 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-gray-300 hover:bg-white hover:shadow-xl sm:p-6 md:p-8">
  <a href={destination} target={project.caseStudy ? undefined : "_blank"} rel={project.caseStudy ? undefined : "noopener noreferrer"} class="absolute inset-0 rounded-2xl" aria-label={`View ${project.title}`}></a>
  <div class="pointer-events-none absolute right-5 top-5 flex size-10 items-center justify-center rounded-full bg-gray-900 text-white transition-all duration-300 group-hover:bg-gray-700 sm:right-6 sm:top-6 sm:size-11 md:right-8 md:top-8 md:size-12">
    <svg aria-hidden="true" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 md:size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7m0 0H7m10 0v10" /></svg>
  </div>
  <div class="space-y-4">
    <div class="pr-14 md:pr-16">
      <span class="text-sm text-[var(--accent-color)]">{project.number} · {project.category}</span>
      <h3 class="mt-1 text-xl font-bold text-gray-900 sm:text-2xl">{project.title}</h3>
    </div>
    <p class="pr-10 text-base leading-relaxed text-gray-600 sm:text-lg">{project.description}</p>
    <ul class="relative z-10 flex flex-wrap gap-2 pt-2" aria-label={`${project.title} technologies`}>
      {project.tags.map((tag) => <li class="rounded-lg bg-gray-900 px-3 py-1.5 text-xs font-medium text-white transition-colors group-hover:bg-gray-800 sm:text-sm">{tag}</li>)}
    </ul>
    {project.caseStudy && (
      <div class="relative z-10 flex flex-wrap gap-4 pt-2 text-sm font-semibold">
        <a href={`${base}projects/${project.slug}/`} class="text-[var(--accent-color)] hover:underline">Case study</a>
        {project.demo && <a href={project.demo} target="_blank" rel="noopener noreferrer" class="text-gray-700 hover:text-[var(--accent-color)] hover:underline">Live demo ↗</a>}
        <a href={project.code} target="_blank" rel="noopener noreferrer" class="text-gray-700 hover:text-[var(--accent-color)] hover:underline">GitHub ↗</a>
      </div>
    )}
  </div>
</article>
