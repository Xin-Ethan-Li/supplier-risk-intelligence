---
import { capabilities, education, experience, profile, skills } from "../data/portfolio";
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="About" description="About Xin (Ethan) Li, an AI Software Engineer with a backend engineering foundation.">
  <section class="relative isolate overflow-hidden px-8 pb-16 pt-36 sm:px-12 md:px-16 md:pb-24 md:pt-44 lg:px-24">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_700px_700px_at_0%_0%,rgba(29,78,216,.18),transparent_70%)]"></div>
    <p class="text-sm text-[var(--accent-color)]">ABOUT · ENGINEERING WITH CONTEXT</p>
    <h1 class="mt-6 max-w-6xl text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl md:text-8xl">I make AI useful by making the system around it reliable.</h1>
    <p class="mt-8 max-w-4xl text-base leading-8 text-gray-600 sm:text-lg md:text-xl">{profile.summary}</p>
  </section>

  <section class="px-8 py-16 sm:px-12 md:px-16 lg:px-24">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4"><h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl xl:text-7xl">Approach</h2><div class="mt-2 h-[5px] w-[75px] rounded-full bg-[var(--accent-color)]"></div></div>
      <div class="space-y-8 lg:col-span-8"><p class="text-lg leading-relaxed text-gray-600 sm:text-xl md:text-2xl">{profile.about}</p><p class="text-base leading-8 text-gray-600 sm:text-lg">I care about the less glamorous parts that determine whether an AI feature earns trust: data quality, retrieval evaluation, timeouts, fallback behavior, API contracts, observability and clear limits.</p><ul class="flex flex-wrap gap-3" aria-label="Technical skills">{skills.map((skill) => <li class="rounded-full bg-gray-100 px-4 py-2 text-sm font-medium text-gray-800 sm:text-base">{skill}</li>)}</ul><div class="grid gap-4 pt-4 md:grid-cols-3">{capabilities.map((item) => <article class="rounded-xl border border-gray-200 bg-gray-50 p-5"><span class="text-sm text-[var(--accent-color)]">{item.index}</span><h3 class="mt-3 font-bold text-gray-900">{item.title}</h3><p class="mt-2 text-sm leading-6 text-gray-600">{item.text}</p></article>)}</div></div>
    </div>
  </section>

  <section class="px-8 py-16 sm:px-12 md:px-16 lg:px-24">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4"><h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl xl:text-7xl">Journey</h2><div class="mt-2 h-[5px] w-[75px] rounded-full bg-[var(--accent-color)]"></div></div>
      <div class="space-y-8 lg:col-span-8">{experience.map((item) => <article class="rounded-lg border border-gray-100 bg-white p-6 shadow-sm"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between"><div><h3 class="text-xl font-semibold text-gray-900">{item.title}</h3><p class="text-[var(--accent-color)]">{item.company}</p></div><span class="mt-2 text-sm text-gray-500 sm:mt-0">{item.dateRange}</span></div><p class="mt-4 text-sm leading-7 text-gray-600">{item.bullets[0]}</p></article>)}{education.map((item) => <article class="rounded-lg border border-gray-100 bg-white p-6 shadow-sm"><div class="flex flex-col sm:flex-row sm:items-start sm:justify-between"><div><h3 class="text-xl font-semibold text-gray-900">{item.degree}</h3><p class="text-[var(--accent-color)]">{item.school}</p></div><span class="mt-2 text-sm text-gray-500 sm:mt-0">{item.dateRange}</span></div></article>)}</div>
    </div>
  </section>
</PortfolioLayout>
